    "timeoutMs": 15000,
    "requiresDatabase": true,
    "databaseName": "personalink_phase0_rehearsal_20260826_210704"
  },
  "expected": {
    "executedChecks": 2,
    "declaredSkips": 99,
    "harnessesOnDisk": 5
  },
  "harnesses": [
    {
      "file": "check-alpha.js",
      "package": "fixture",
      "run": true
    },
    {
      "file": "check-beta.js",
      "package": "fixture-b",
      "run": true
    },
    {
      "file": "check-red.js",
