        "howToRunManually": "node scripts/gates/run-gates.js --manifest=scripts/gates/fixtures/selftest/manifests/zero-byte.json",
        "declaredBy": "Q1-A driver self-test"
      }
    },
    {
      "file": "check-leaky.js",
      "package": "fixture",
      "run": false,
      "skip": {
        "reason": "Prints a fabricated connection string. Only enabled by manifests/redaction.json, which proves harness output is redacted before it reaches a log file.",
        "requires": "nothing",
        "howToRunManually": "node scripts/gates/run-gates.js --manifest=scripts/gates/fixtures/selftest/manifests/redaction.json",
        "declaredBy": "Q1-A driver self-test"
      }
