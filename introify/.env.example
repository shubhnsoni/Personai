# Copy to .env and fill in real values. Never commit .env.

# Database (PostgreSQL)
DATABASE_URL=
# Optional direct connection used only by the Hostinger migration wrapper.
# Neon pooled URLs can derive their direct hostname when this is unset.
# DIRECT_URL=

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Platform owner (comma-separated). Those emails get User.role=ADMIN on sign-in.
# ADMIN_EMAILS=you@example.com

# Published AI uses an explicitly selected provider and approved model per mode.
# For the existing Codex connection: provider=codex, fast=gpt-5.6-luna,
# smart=gpt-5.6-terra, reasoning=gpt-5.6-sol. All plans still use account credits.
INTROIFY_AI_PROVIDER=openai
INTROIFY_AI_FAST_MODEL=
INTROIFY_AI_SMART_MODEL=
INTROIFY_AI_REASONING_MODEL=
INTROIFY_AI_DISABLED=false
# Optional actual provider price rates for cost estimates (unset means unknown):
# INTROIFY_AI_FAST_INPUT_USD_PER_MTOK=
# INTROIFY_AI_FAST_OUTPUT_USD_PER_MTOK=
# Repeat for SMART and REASONING. Approved models are in src/lib/ai-runtime.ts.
XAI_API_KEY=
OPENAI_API_KEY=
# Codex auth stays server-only, outside web/upload directories. Use a dedicated
# persistent writable home, e.g. /home/USER/.introify-codex. Never commit auth.json.
# CODEX_HOME=
# CODEX_AUTH_JSON= (JSON or base64 seed from a Codex login; refresh is persisted)
# CODEX_AUTH_REVISION= (change when replacing the seed with a new login)
# CODEX_DISABLED=false

# Payments (Stripe)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Introify subscriptions are separate from merchant/customer-sale webhooks above.
# Keep disabled until operator/legal details, Stripe tax/terms settings, and live
# webhook delivery have been verified. Production rejects test-mode fulfillment.
INTROIFY_BILLING_ENABLED=false
INTROIFY_BILLING_MODE=test
INTROIFY_STRIPE_WEBHOOK_SECRET=
# Register /api/billing/webhook for checkout.session.completed,
# checkout.session.async_payment_succeeded, invoice.paid, invoice.payment_failed,
# customer.subscription.created/updated/deleted, charge.refunded,
# and charge.dispute.created. The durable inbox retries failures in the worker.

# Email (Resend) — optional. Unset RESEND_API_KEY to keep the console fallback.
RESEND_API_KEY=
# FROM_EMAIL / EMAIL_FROM stay unset. Do not send real mail.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://introify.com

# INR display/charge rate vs stored USD prices (India visitors). Default 87.
# USD_INR_RATE=87

# Photoreal 3D consumes separate generation credits; never auto-purchases top-ups.
INTROIFY_PHOTOREAL_ENABLED=false
INTROIFY_WORKER_ENABLED=false
INTROIFY_FREE_TRIAL_DAILY_LIMIT=25
INTROIFY_PHOTOREAL_DAILY_LIMIT=50
INTROIFY_PHOTOREAL_CONCURRENCY=4
# MESHY_API_KEY=
# Provider cost accounting only; subscription/pack prices come from catalog.ts.
# MESHY_CREDIT_USD_CENTS=2
