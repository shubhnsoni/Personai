# Copy to .env and fill in real values. Never commit .env.

# Database (PostgreSQL)
DATABASE_URL=
# Optional direct connection used only by the Hostinger migration wrapper.
# Neon pooled URLs can derive their direct hostname when this is unset.
# DIRECT_URL=

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Platform owner (comma-separated). Those emails get User.role=ADMIN on sign-in.
# ADMIN_EMAILS=you@example.com

# AI — Codex (ChatGPT login via `codex login`, same as OpenClaw) is used for chats
# when ~/.codex/auth.json exists. On Hostinger, set CODEX_HOME to a persistent
# directory and CODEX_AUTH_JSON to the auth.json body (or its base64).
# SpaceXAI / OpenAI keys are fallbacks.
# CODEX_HOME=
# CODEX_AUTH_JSON=
# Optional: change only to deliberately replace a legacy persisted login.
# CODEX_AUTH_REVISION=
# CODEX_MODEL=gpt-5.6-terra
# CODEX_DISABLED=1
XAI_API_KEY=
OPENAI_API_KEY=

# Payments (Stripe)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend) — optional. Unset RESEND_API_KEY to keep the console fallback.
RESEND_API_KEY=
# FROM_EMAIL / EMAIL_FROM stay unset. Do not send real mail.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://introify.com

# INR display/charge rate vs stored USD prices (India visitors). Default 87.
# USD_INR_RATE=87

# Photoreal 3D (server-only). Never expose this vendor in the UI.
# MESHY_API_KEY=
# USD cents we pay per generation credit. Default 2 ($0.02, Pro $20 / 1000 credits).
# Charge to owners is 3× that × 30 credits per textured model.
# MESHY_CREDIT_USD_CENTS=2
