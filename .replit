modules = ["nodejs-20", "postgresql-16", "python-3.11"]
[nix]
channel = "stable-25_05"
packages = ["unzip"]

[agent]
expertMode = true
integrations = ["javascript_openai_ai_integrations:1.0.0", "stripe:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Next.js Dev Server"

[[workflows.workflow]]
name = "Next.js Dev Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd aiclone && npm run dev -- -p 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 35559
externalPort = 6000

[[ports]]
localPort = 36635
externalPort = 3001

[[ports]]
localPort = 37205
externalPort = 3003

[[ports]]
localPort = 38099
externalPort = 4200

[[ports]]
localPort = 41923
externalPort = 5173

[[ports]]
localPort = 43427
externalPort = 3002

[[ports]]
localPort = 43743
externalPort = 3000

[[ports]]
localPort = 44839
externalPort = 5000

[userenv]

[userenv.shared]
