generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderChannel {
  DINE_IN
  TAKEAWAY
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  SERVED
  PAID
  CANCELLED
}

enum OrderLineStatus {
  QUEUED
  PREPARING
  READY
  SERVED
}

enum OrderPayMethod {
  UPI
  COD
  WHATSAPP
  STRIPE
}

enum OrderPayStatus {
  UNPAID
  PAID
  REFUNDED
}

enum OrderEventActor {
  GUEST
  STAFF
  SYSTEM
}

enum OrderEventKind {
  CREATED
  ORDER_STATUS
  LINE_STATUS
  PAYMENT_STATUS
  BACKFILL
}

enum OfferReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum ProfileImageCategory {
  AMBIENCE
  INTERIOR
  FOOD
  TEAM
  EVENT
}

/// Reservation lifecycle. Terminal states are COMPLETED, CANCELLED and NO_SHOW.
/// Transitions are enforced in src/lib/reservations, not by the database alone.
enum ReservationStatus {
  REQUESTED
  HELD
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReservationEventKind {
  CREATED
  STATUS
  HOLD_EXPIRED
}

/// Deliberately separate from OrderEventActor so the existing order enum is not
/// widened or otherwise modified.
enum ReservationEventActor {
  GUEST
  STAFF
  SYSTEM
}

model User {
  id                     String   @id @default(cuid())
  clerkId                String   @unique // Map to Clerk User ID
  email                  String   @unique
  name                   String?
  image                  String?
  role                   String   @default("CREATOR") // "CREATOR" | "ADMIN"
  stripeConnectAccountId String? // Stripe Connect account for payouts
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  profiles      Profile[]
  notifications Notification[]
}

model Profile {
  id                     String                  @id @default(cuid())
  userId                 String
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug                   String                  @unique
  displayName            String
  headline               String?
  bio                    String?
  roleTemplate           String                  @default("CUSTOM") // Enum as String
  primaryGoal            String                  @default("BOOK_CALL") // Enum as String
  language               String                  @default("en")
  timezone               String                  @default("UTC")
  themeColor             String                  @default("#000000")
  imageUrl               String?
  shopLogoUrl            String?
  whatsapp               String?
  upiId                  String?
  gstin                  String?
  deliveryNote           String?
  chatAvatarMode         String                  @default("ORB") // "ORB" | "IMAGE"
  animationStyleId       String?
  animationStyle         WelcomeAnimationPreset? @relation(fields: [animationStyleId], references: [id])
  isPublic               Boolean                 @default(false)
  showInDirectory        Boolean                 @default(false)
  welcomeMessageOverride String?
  contentDisplayMode     String                  @default("POPUP") // "SIDE_PANEL" | "POPUP"
  personalityConfig      String? // JSON: {tone, customInstructions, responseLength, language}
  aiModel                String                  @default("gpt-4o-mini") // "gpt-4o-mini" | "gpt-4o"
  autoMemoryEnabled      Boolean                 @default(false)
  liveChatEnabled        Boolean                 @default(false)
  liveChatSlaMinutes     Int                     @default(10)
  bufferMinutes          Int                     @default(0)
  calendarToken          String?                 @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  documents         ProfileDocument[]
  serviceOfferings  ServiceOffering[]
  bookings          Booking[]
  conversations     Conversation[]
  payments          Payment[]
  leads             VisitorLead[]
  availability      AvailabilitySchedule[]
  calendarOverrides CalendarOverride[]
  workExperiences   WorkExperience[]
  projects          Project[]
  digitalProducts   DigitalProduct[]
  courses           Course[]
  events            Event[]
  communities       Community[]
  leadMagnets       LeadMagnet[]
  shortLinks        ShortLink[]
  analyticsEvents   ProfileEvent[]
  restaurantOrders  Order[]
  restaurantTables  RestaurantTable[]
  orderCounters     OrderCounter[]
  profileImages     ProfileImage[]
  restaurantReviews OfferReview[]
  reservations      Reservation[]
}

model ProfileEvent {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  path      String?
  ref       String?
  visitor   String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
  @@index([profileId, name, createdAt])
}

model WorkExperience {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company      String
  role         String
  startDate    String // e.g. "2022" or "Jan 2022"
  endDate      String? // null = Present
  description  String?
  achievements String? // JSON string array
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  description String?
  client      String?
  year        String?
  imageUrl    String?
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WelcomeAnimationPreset {
  id          String   @id @default(cuid())
  name        String
  description String?
  config      String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profiles Profile[]
}

model ProfileDocument {
  id                String   @id @default(cuid())
  profileId         String
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type              String // Enum
  title             String
  sourceType        String // Enum
  url               String?
  filePath          String?
  rawText           String?
  embedding         Float[] // OpenAI embedding vector
  embeddingMetadata String? // Json
  visitorKey        String?
  memberId          String?
  conversationId    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([profileId, visitorKey])
}

model ServiceOffering {
  id                String   @id @default(cuid())
  profileId         String
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  priceCents        Int      @default(0)
  currency          String   @default("USD")
  isFree            Boolean  @default(false)
  durationMinutes   Int      @default(30)
  isActive          Boolean  @default(true)
  isRecurring       Boolean  @default(false)
  packageSessions   Int      @default(1)
  maxBookingsPerDay Int?
  kind              String   @default("SESSION") // "SESSION" | "TABLE"
  covers            Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  bookings Booking[]
}

model Booking {
  id                String          @id @default(cuid())
  profileId         String
  profile           Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  visitorId         String?
  visitorName       String
  visitorEmail      String
  memberId          String?
  member            Member?         @relation(fields: [memberId], references: [id])
  serviceOfferingId String
  serviceOffering   ServiceOffering @relation(fields: [serviceOfferingId], references: [id])
  startTime         DateTime
  endTime           DateTime
  status            String          @default("PENDING_PAYMENT") // Enum
  paymentId         String?         @unique
  payment           Payment?        @relation(fields: [paymentId], references: [id])
  metadata          String? // Json
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Payment {
  id                String   @id @default(cuid())
  profileId         String
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  bookingId         String?  @unique
  booking           Booking?
  amountCents       Int
  currency          String
  status            String   @default("PENDING") // Enum
  provider          String   @default("STRIPE") // Enum
  providerPaymentId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Conversation {
  id                  String    @id @default(cuid())
  profileId           String
  profile             Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  visitorId           String?
  visitorName         String?
  visitorEmail        String?
  memberId            String?
  member              Member?   @relation(fields: [memberId], references: [id])
  source              String    @default("PROFILE_PAGE") // Enum
  leadStatus          String    @default("NEW") // Enum
  notes               String?
  mode                String    @default("AI") // "AI" | "LIVE_REQUESTED" | "LIVE"
  liveRequestedAt     DateTime?
  liveRespondedAt     DateTime?
  lastSummarizedMsgId String?
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  lastMessageAt       DateTime  @default(now())

  messages     Message[]
  visitorLeads VisitorLead[]

  @@index([profileId, visitorId])
  @@index([profileId, mode])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     String // Enum
  text           String
  role           String
  createdAt      DateTime     @default(now())
}

model VisitorLead {
  id             String        @id @default(cuid())
  profileId      String
  profile        Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  name           String
  email          String
  company        String?
  budgetRange    String?
  status         String        @default("NEW") // Enum
  tags           String? // Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model AdminSettings {
  id    String @id @default(cuid())
  key   String @unique
  value String // Json
}

model AvailabilitySchedule {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0-6 (Sun-Sat)
  startTime String // "09:00"
  endTime   String // "17:00"
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CalendarOverride {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date      DateTime
  isBlocked Boolean  @default(true)
  startTime String?
  endTime   String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId, date])
}

// ==================== SuperProfile-like Features ====================

model DigitalProduct {
  id             String   @id @default(cuid())
  profileId      String
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  type           String   @default("OTHER") // "PDF" | "VIDEO" | "AUDIO" | "OTHER" | "PHYSICAL"
  fileUrl        String?
  thumbnailUrl   String?
  subtitle       String?
  body           String?
  compareAtCents Int?
  highlights     String?
  galleryUrls    String?
  fulfillment    String   @default("DIGITAL") // "DIGITAL" | "PHYSICAL" | "BOTH"
  stock          Int?
  sku            String?
  weightGrams    Int?
  allowCod       Boolean  @default(false)
  category       String?
  diet           String?
  spiceLevel     Int?
  serveWindow    String?
  arModelUrl     String?
  arUsdzUrl      String?
  variantsJson   String?
  shipMode       String   @default("NONE") // "NONE" | "PICKUP" | "DELIVER" | "BOTH"
  shipFeeCents   Int      @default(0)
  priceCents     Int      @default(0)
  currency       String   @default("USD")
  isActive       Boolean  @default(true)
  downloadCount  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchases  ProductPurchase[]
  reviews    OfferReview[]
  orderLines OrderLine[]
}

model Course {
  id             String   @id @default(cuid())
  profileId      String
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  thumbnailUrl   String?
  subtitle       String?
  body           String?
  outcomes       String?
  level          String   @default("ALL")
  compareAtCents Int?
  priceCents     Int      @default(0)
  currency       String   @default("USD")
  isActive       Boolean  @default(true)
  isPublished    Boolean  @default(false)
  totalModules   Int      @default(0)
  totalLessons   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  modules     CourseModule[]
  enrollments CourseEnrollment[]
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons CourseLesson[]
}

model CourseLesson {
  id              String       @id @default(cuid())
  moduleId        String
  module          CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  contentType     String       @default("VIDEO") // "VIDEO" | "TEXT" | "PDF"
  contentUrl      String?
  videoUrl        String?
  body            String?
  fileUrl         String?
  durationMinutes Int          @default(0)
  orderIndex      Int          @default(0)
  isFree          Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Event {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  eventType    String   @default("WEBINAR") // "WEBINAR" | "WORKSHOP" | "MEETUP"
  thumbnailUrl String?
  startTime    DateTime
  endTime      DateTime
  timezone     String   @default("UTC")
  location     String? // For offline events
  meetingUrl   String? // For online events
  priceCents   Int      @default(0)
  currency     String   @default("USD")
  isFree       Boolean  @default(false)
  maxAttendees Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  registrations EventRegistration[]
}

model Community {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  platform     String   @default("TELEGRAM") // "TELEGRAM" | "DISCORD"
  inviteLink   String?
  priceCents   Int      @default(0)
  currency     String   @default("USD")
  billingCycle String   @default("MONTHLY") // "MONTHLY" | "YEARLY" | "ONE_TIME"
  isActive     Boolean  @default(true)
  memberCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members CommunityMember[]
}

model LeadMagnet {
  id            String   @id @default(cuid())
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  type          String   @default("DOWNLOAD") // "FORM" | "GIVEAWAY" | "DOWNLOAD"
  fileUrl       String?
  formFields    String? // JSON array of form field definitions
  isActive      Boolean  @default(true)
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  submissions LeadMagnetSubmission[]
}

model ShortLink {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  code      String   @unique // Unique short code for the link
  targetUrl String
  title     String?
  clicks    Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Member {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String?
  imageUrl   String?
  clerkId    String?  @unique
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sessions      MemberSession[]
  libraryLinks  LibraryLink[]
  purchases     ProductPurchase[]
  enrollments   CourseEnrollment[]
  events        EventRegistration[]
  communities   CommunityMember[]
  bookings      Booking[]
  conversations Conversation[]
}

model MemberSession {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model LibraryLink {
  id        String    @id @default(cuid())
  memberId  String
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ProductPurchase {
  id             String         @id @default(cuid())
  productId      String
  product        DigitalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  memberId       String?
  member         Member?        @relation(fields: [memberId], references: [id])
  visitorEmail   String
  visitorName    String?
  paymentId      String?
  status         String         @default("PENDING") // "PENDING" | "COMPLETED" | "REFUNDED"
  payMethod      String?
  buyerNote      String?
  address        String?
  confirmedAt    DateTime?
  downloadToken  String?        @unique
  downloadExpiry DateTime?
  downloadedAt   DateTime?
  createdAt      DateTime       @default(now())
}

model OfferReview {
  id             String            @id @default(cuid())
  productId      String?
  product        DigitalProduct?   @relation(fields: [productId], references: [id], onDelete: Cascade)
  profileId      String?
  profile        Profile?          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  orderId        String?
  order          Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rating         Int
  text           String?
  imageUrl       String?
  visitorName    String
  status         OfferReviewStatus @default(PUBLISHED)
  ownerReply     String?
  ownerRepliedAt DateTime?
  createdAt      DateTime          @default(now())

  @@index([productId, status, createdAt])
  @@index([profileId, status, createdAt])
  @@index([orderId])
}

model Order {
  id             String           @id @default(cuid())
  profileId      String
  profile        Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  publicToken    String           @unique
  idempotencyKey String?
  legacyGroupKey String?          @unique
  number         Int
  businessDate   DateTime         @db.Date
  channel        OrderChannel     @default(DINE_IN)
  tableId        String?
  table          RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableLabel     String?
  status         OrderStatus      @default(PLACED)
  guestName      String?
  guestPhone     String?
  guestEmail     String?
  note           String?
  subtotalCents  Int
  taxCents       Int              @default(0)
  totalCents     Int
  currency       String
  payMethod      OrderPayMethod?
  payStatus      OrderPayStatus   @default(UNPAID)
  paidAt         DateTime?
  paidBy         String?
  paymentRef     String?
  placedAt       DateTime         @default(now())
  acceptedAt     DateTime?
  preparingAt    DateTime?
  readyAt        DateTime?
  servedAt       DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  updatedAt      DateTime         @updatedAt

  lines   OrderLine[]
  events  OrderEvent[]
  reviews OfferReview[]

  @@unique([profileId, businessDate, number])
  @@unique([profileId, idempotencyKey])
  @@index([profileId, status])
  @@index([profileId, placedAt])
  @@index([publicToken, status])
}

model OrderLine {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?
  product           DigitalProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  titleSnapshot     String
  skuSnapshot       String?
  qty               Int
  unitPriceCents    Int
  unitModifierCents Int             @default(0)
  modifiers         Json?
  modifiersLabel    String?
  lineTotalCents    Int
  status            OrderLineStatus @default(QUEUED)
  legacyPurchaseId  String?         @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  events OrderEvent[]

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLineId String?
  orderLine   OrderLine?      @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  seq         BigInt          @default(autoincrement())
  kind        OrderEventKind
  from        String?
  to          String
  actor       OrderEventActor
  actorId     String?
  metadata    Json?
  at          DateTime        @default(now())

  @@index([orderId, seq])
  @@index([orderLineId, seq])
}

model RestaurantTable {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  label     String
  seats     Int?
  zone      String?
  code      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  scans     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders       Order[]
  reservations Reservation[]

  @@unique([profileId, label])
  @@index([profileId, isActive, sortOrder])
}

/// A table booking held against a real RestaurantTable.
///
/// Tenancy: profileId, matching RestaurantTable/Order/OrderCounter rather than
/// introducing a second tenant key. Platform API access resolves workspace
/// membership to Workspace.profileId (already @unique) and requires it to equal
/// this profileId, which is what makes venue isolation checkable.
///
/// Overlap prevention is enforced two ways: a transactional row lock on the
/// parent RestaurantTable in src/lib/reservations, plus a Postgres exclusion
/// constraint added by the migration as defense-in-depth. Neither is sufficient
/// alone: the constraint cannot express "non-terminal only" through Prisma, and
/// the row lock alone would not survive a direct SQL writer.
model Reservation {
  id             String            @id @default(cuid())
  profileId      String
  profile        Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tableId        String
  table          RestaurantTable   @relation(fields: [tableId], references: [id], onDelete: Restrict)
  idempotencyKey String?
  partySize      Int
  startAt        DateTime
  endAt          DateTime
  status         ReservationStatus @default(REQUESTED)
  guestName      String
  guestPhone     String?
  guestEmail     String?
  note           String?
  holdExpiresAt  DateTime?
  confirmedAt    DateTime?
  seatedAt       DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  noShowAt       DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  events ReservationEvent[]

  @@unique([profileId, idempotencyKey])
  @@index([profileId, status])
  @@index([profileId, startAt])
  @@index([tableId, startAt])
}

/// Append-only reservation ledger. UPDATE and DELETE are refused by database
/// trigger using the existing reject_append_only_mutation() function created by
/// 20260827140000_phase0_foundations.
model ReservationEvent {
  id            String                @id @default(cuid())
  reservationId String
  reservation   Reservation           @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  seq           BigInt                @default(autoincrement())
  kind          ReservationEventKind
  from          String?
  to            String
  actor         ReservationEventActor
  actorId       String?
  metadata      Json?
  at            DateTime              @default(now())

  @@index([reservationId, seq])
}

model OrderCounter {
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  businessDate DateTime @db.Date
  value        Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@id([profileId, businessDate])
}

model ProfileImage {
  id        String               @id @default(cuid())
  profileId String
  profile   Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  category  ProfileImageCategory @default(AMBIENCE)
  sortOrder Int                  @default(0)
  createdAt DateTime             @default(now())

  @@index([profileId, sortOrder])
}

model CourseEnrollment {
  id           String    @id @default(cuid())
  courseId     String
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  memberId     String?
  member       Member?   @relation(fields: [memberId], references: [id])
  visitorEmail String
  visitorName  String?
  paymentId    String?
  status       String    @default("PENDING") // "PENDING" | "ACTIVE" | "COMPLETED" | "CANCELLED"
  progress     String? // JSON object tracking lesson completion
  enrolledAt   DateTime  @default(now())
  completedAt  DateTime?

  lessonCompletions LessonCompletion[]
}

model LessonCompletion {
  id           String           @id @default(cuid())
  enrollmentId String
  enrollment   CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  completedAt  DateTime         @default(now())

  @@unique([enrollmentId, lessonId])
}

model EventRegistration {
  id           String    @id @default(cuid())
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId     String?
  member       Member?   @relation(fields: [memberId], references: [id])
  visitorEmail String
  visitorName  String?
  paymentId    String?
  status       String    @default("REGISTERED") // "REGISTERED" | "ATTENDED" | "CANCELLED"
  attendedAt   DateTime?
  createdAt    DateTime  @default(now())
}

model CommunityMember {
  id                 String    @id @default(cuid())
  communityId        String
  community          Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  memberId           String?
  member             Member?   @relation(fields: [memberId], references: [id])
  visitorEmail       String
  visitorName        String?
  paymentId          String?
  status             String    @default("ACTIVE") // "ACTIVE" | "EXPIRED" | "CANCELLED"
  subscriptionEndsAt DateTime?
  createdAt          DateTime  @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model LeadMagnetSubmission {
  id           String     @id @default(cuid())
  leadMagnetId String
  leadMagnet   LeadMagnet @relation(fields: [leadMagnetId], references: [id], onDelete: Cascade)
  visitorEmail String
  visitorName  String?
  formData     String? // JSON object with form field values
  createdAt    DateTime   @default(now())
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  VIEWER
}

model Workspace {
  id        String   @id @default(cuid())
  profileId String?  @unique
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations    Location[]
  memberships  Membership[]
  contacts     Contact[]
  workflowRuns WorkflowRun[]

  @@index([profileId])
}

model Location {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  timezone    String    @default("UTC")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  membershipLocations MembershipLocation[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Membership {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  role        MembershipRole
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  membershipLocations MembershipLocation[]

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
}

model MembershipLocation {
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  locationId   String
  location     Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([membershipId, locationId])
  @@index([locationId])
}

model Contact {
  id          String     @id @default(cuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  profileId   String?
  displayName String?
  email       String?
  phone       String?
  confidence  String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  sourceLinks ContactSourceLink[]
  activities  ActivityEvent[]

  @@index([workspaceId, email])
  @@index([workspaceId, phone])
  @@index([profileId, email])
  @@index([profileId, phone])
}

model ContactSourceLink {
  id         String   @id @default(cuid())
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sourceKind String
  sourceId   String
  profileId  String?
  observedAt DateTime

  @@unique([sourceKind, sourceId])
  @@index([contactId])
  @@index([profileId])
}

model ActivityEvent {
  id         String    @id
  contactId  String
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  profileId  String?
  type       String
  sourceKind String
  sourceId   String
  occurredAt DateTime?
  summary    String
  metadata   String?
  createdAt  DateTime  @default(now())

  @@index([contactId, occurredAt, id])
  @@index([profileId, occurredAt, id])
  @@index([sourceKind, sourceId])
}

model TaskJob {
  id             String    @id @default(cuid())
  idempotencyKey String?   @unique
  payload        String
  state          String
  attempts       Int       @default(0)
  maxAttempts    Int
  nextAttemptAt  DateTime
  leaseExpiresAt DateTime?
  leaseToken     String?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([state, nextAttemptAt])
}

model WorkflowRun {
  id             String     @id @default(cuid())
  workspaceId    String?
  workspace      Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  profileId      String?
  workflowKey    String
  workflowName   String
  state          String
  idempotencyKey String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  completedAt    DateTime?
  failureCode    String?
  failureDetail  String?

  agentRuns   AgentRun[]
  steps       WorkflowStep[]
  approvals   Approval[]
  auditEvents CopilotAuditEvent[]

  @@unique([profileId, idempotencyKey])
  @@index([workspaceId, state, createdAt])
  @@index([profileId, state, createdAt])
  @@index([state, updatedAt])
}

model AgentRun {
  id            String      @id @default(cuid())
  workflowRunId String
  workflowRun   WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  agentKey      String
  state         String
  attempt       Int         @default(1)
  startedAt     DateTime?
  completedAt   DateTime?
  failureCode   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  auditEvents CopilotAuditEvent[]

  @@index([workflowRunId, createdAt])
  @@index([state, updatedAt])
}

model WorkflowStep {
  id            String      @id @default(cuid())
  workflowRunId String
  workflowRun   WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  ordinal       Int
  label         String
  state         String
  startedAt     DateTime?
  completedAt   DateTime?
  inputJson     Json?
  resultJson    Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  toolCalls ToolCall[]
  approvals Approval[]

  @@unique([workflowRunId, ordinal])
  @@index([workflowRunId, state, ordinal])
}

model ToolCall {
  id             String       @id @default(cuid())
  workflowStepId String
  workflowStep   WorkflowStep @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)
  ordinal        Int
  toolName       String
  inputJson      Json
  outputJson     Json?
  state          String
  startedAt      DateTime?
  completedAt    DateTime?
  errorCode      String?
  createdAt      DateTime     @default(now())

  @@unique([workflowStepId, ordinal])
  @@index([workflowStepId, createdAt])
}

model Approval {
  id             String        @id @default(cuid())
  workflowRunId  String
  workflowRun    WorkflowRun   @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  workflowStepId String?
  workflowStep   WorkflowStep? @relation(fields: [workflowStepId], references: [id], onDelete: SetNull)
  reason         String
  state          String
  requestedBy    String
  requestedAt    DateTime      @default(now())
  decidedBy      String?
  decidedAt      DateTime?
  decisionNote   String?

  @@index([workflowRunId, state, requestedAt])
  @@index([workflowStepId])
  @@index([state, requestedAt])
}

model CopilotAuditEvent {
  id            String      @id @default(cuid())
  workflowRunId String
  workflowRun   WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  agentRunId    String?
  agentRun      AgentRun?   @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  sequence      Int
  eventType     String
  actorType     String
  actorId       String?
  occurredAt    DateTime    @default(now())
  payloadJson   Json

  @@unique([workflowRunId, sequence])
  @@index([workflowRunId, sequence])
  @@index([agentRunId])
  @@index([eventType, occurredAt])
}
