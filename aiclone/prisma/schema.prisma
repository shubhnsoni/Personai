// ===========================================================================
// Wave C / P2-006 — shared cases and projects foundation.
//
// One engine for consultants, agencies, CA/accounting practices, events and real
// estate. Deliberately COMPOSES the systems that already exist rather than
// duplicating them:
//
//   * Contact            — clients are Contacts, not a new party table
//   * TaskJob            — case work items are durable tasks, via CaseTaskLink
//   * Approval           — sign-off reuses the copilot approval ledger, via CaseApprovalLink
//   * ProfileDocument    — uploaded files stay ProfileDocuments, via CaseDocumentRequest
//   * ActivityEvent      — contact-level timeline is untouched; CaseEvent is case-level
//   * Workspace/Location — tenancy, no new tenant key
//   * Payment            — CaseInvoice records STATE and links out; it is not a ledger
//
// NAME NOTE: `Project` is already taken by the pre-existing portfolio model, so the
// case aggregate is `CaseProject`. Renaming the existing model would have been a
// breaking change for no benefit.
//
// Tenancy is workspaceId, which is what /api/platform already authorizes against.
// Unlike the restaurant and appointment domains there is no legacy profileId-scoped
// table to bridge to, so no bridge is invented.
// ===========================================================================

enum CaseStatus {
  INTAKE
  BRIEFED
  ACTIVE
  ON_HOLD
  DELIVERED
  CLOSED
  CANCELLED
}

enum CaseIntakeStatus {
  NEW
  QUALIFYING
  ACCEPTED
  DECLINED
  CONVERTED
}

enum CaseMilestoneStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
  CANCELLED
}

enum CaseDeliverableStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  DELIVERED
  REJECTED
}

enum CaseDocumentRequestStatus {
  REQUESTED
  RECEIVED
  WAIVED
  REJECTED
}

/// Billing STATE only. Money movement stays with Payment; this records where an
/// invoice is, so the engine never becomes a second accounting ledger.
enum CaseInvoiceState {
  NONE
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
  WRITTEN_OFF
}

enum CaseEventKind {
  CREATED
  STATUS
  MILESTONE
  DELIVERABLE
  DOCUMENT
  INVOICE
  TASK
  APPROVAL
  RETAINER
  NOTE
}

enum CaseEventActor {
  CLIENT
  STAFF
  SYSTEM
}

/// Lead / intake. Exists before a case does, so it is a sibling of CaseProject
/// rather than a field on it.
model CaseIntake {
  id             String           @id @default(cuid())
  workspaceId    String
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  source         String
  summary        String
  status         CaseIntakeStatus @default(NEW)
  declineReason  String?
  idempotencyKey String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  convertedCase CaseProject?

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status, createdAt])
  @@index([contactId])
}

/// The case or project aggregate.
model CaseProject {
  id             String           @id @default(cuid())
  workspaceId    String
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  locationId     String?
  location       Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  intakeId       String?          @unique
  intake         CaseIntake?      @relation(fields: [intakeId], references: [id], onDelete: SetNull)
  reference      String
  title          String
  status         CaseStatus       @default(INTAKE)
  invoiceState   CaseInvoiceState @default(NONE)
  openedAt       DateTime?
  deliveredAt    DateTime?
  closedAt       DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  idempotencyKey String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  brief                CaseBrief?
  milestones           CaseMilestone[]
  deliverables         CaseDeliverable[]
  documentRequests     CaseDocumentRequest[]
  invoices             CaseInvoice[]
  events               CaseEvent[]
  taskLinks            CaseTaskLink[]
  approvalLinks        CaseApprovalLink[]
  CaseRetainerCaseLink CaseRetainerCaseLink[]
  CaseRetainerDraw     CaseRetainerDraw[]

  @@unique([workspaceId, reference])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status, createdAt])
  @@index([contactId])
}

/// Agreed scope. One per case, so a 1:1 rather than a repeated row.
model CaseBrief {
  id          String      @id @default(cuid())
  caseId      String      @unique
  case        CaseProject @relation(fields: [caseId], references: [id], onDelete: Cascade)
  objectives  String
  scope       String?
  constraints String?
  agreedAt    DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model CaseMilestone {
  id              String              @id @default(cuid())
  caseId          String
  case            CaseProject         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title           String
  ordinal         Int
  status          CaseMilestoneStatus @default(PENDING)
  dueAt           DateTime?
  completedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  CaseDeliverable CaseDeliverable[]

  @@unique([caseId, ordinal])
  @@index([caseId, status])
}

model CaseDeliverable {
  id          String                @id @default(cuid())
  caseId      String
  case        CaseProject           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   CaseMilestone?        @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title       String
  status      CaseDeliverableStatus @default(DRAFT)
  /// Reuses ProfileDocument rather than storing a second copy of the file.
  documentId  String?
  document    ProfileDocument?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  deliveredAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([caseId, status])
  @@index([milestoneId])
}

/// A request for something the client must supply. When it arrives it is linked to an
/// existing ProfileDocument; no parallel upload store is introduced.
model CaseDocumentRequest {
  id           String                    @id @default(cuid())
  caseId       String
  case         CaseProject               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  status       CaseDocumentRequestStatus @default(REQUESTED)
  dueAt        DateTime?
  documentId   String?
  document     ProfileDocument?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  receivedAt   DateTime?
  waivedReason String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([caseId, status])
}

/// Invoice STATE for a case. `paymentId` links to the existing Payment row when one
/// exists; this table never holds amounts that contradict it.
model CaseInvoice {
  id                 String               @id @default(cuid())
  caseId             String
  case               CaseProject          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reference          String
  amountCents        Int
  currency           String               @default("USD")
  state              CaseInvoiceState     @default(DRAFT)
  issuedAt           DateTime?
  paidAt             DateTime?
  paymentId          String?
  idempotencyKey     String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  CaseRetainerPeriod CaseRetainerPeriod[]

  @@unique([caseId, reference])
  @@index([caseId, state])
}

/// Composition link to the EXISTING durable task queue. Case work items are TaskJobs;
/// this table only records which case they belong to.
model CaseTaskLink {
  caseId    String
  case      CaseProject @relation(fields: [caseId], references: [id], onDelete: Cascade)
  taskJobId String
  taskJob   TaskJob     @relation(fields: [taskJobId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@id([caseId, taskJobId])
  @@index([taskJobId])
}

/// Composition link to the EXISTING approval ledger. Case sign-off reuses Approval
/// rather than defining a second approval concept.
model CaseApprovalLink {
  caseId     String
  case       CaseProject @relation(fields: [caseId], references: [id], onDelete: Cascade)
  approvalId String
  approval   Approval    @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@id([caseId, approvalId])
  @@index([approvalId])
}

/// Append-only case timeline. UPDATE and DELETE are refused by trigger, reusing
/// reject_append_only_mutation() from 20260827140000_phase0_foundations.
///
/// This is case-level and deliberately separate from ActivityEvent, which is
/// contact-level and remains untouched.
model CaseEvent {
  id       String         @id @default(cuid())
  caseId   String
  case     CaseProject    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  seq      BigInt         @default(autoincrement())
  kind     CaseEventKind
  from     String?
  to       String
  actor    CaseEventActor
  actorId  String?
  metadata Json?
  at       DateTime       @default(now())

  @@index([caseId, seq])
}

// ---------------------------------------------------------------------------
// Wave D / P2-008: shared content and cohort persistence.
//
// The PROGRAM is the pre-existing Course, with its CourseModule and CourseLesson
// children. Nothing here forks a coaching-only content tree. Learner identity stays
// Member, the learner's relation to a program stays CourseEnrollment, and per-lesson
// progress stays LessonCompletion, which is why no progress table is added: progress
// is computed from the completion rows that already exist.
//
// A Cohort is the missing concept - a dated, capacity-bounded run of a Course that
// people attend together. Everything below hangs off it.
//
// Tenancy is profileId, bridged from the caller's workspace exactly as the appointment
// domain does, because Course is already profileId-scoped and Workspace.profileId is
// unique. Inventing a second tenant key for cohorts would have split the course tree.
//
// Reuse, not duplication:
//   - uploads are ProfileDocuments (submissions, certificates)
//   - reminder dispatch is a TaskJob, pointed at from the membership
//   - venues are Locations
//   - money stays on CourseEnrollment.paymentId
// ---------------------------------------------------------------------------

enum CohortStatus {
  PLANNED
  ENROLLING
  RUNNING
  COMPLETED
  CANCELLED
}

enum CohortMembershipStatus {
  INVITED
  ACTIVE
  PAUSED
  COMPLETED
  WITHDRAWN
}

enum CohortSessionStatus {
  SCHEDULED
  IN_PROGRESS
  HELD
  CANCELLED
}

enum CohortAttendanceStatus {
  PRESENT
  LATE
  EXCUSED
  ABSENT
}

enum CohortSubmissionState {
  DRAFT
  SUBMITTED
  RETURNED
  ACCEPTED
  REJECTED
}

enum CohortCertificateState {
  INELIGIBLE
  ELIGIBLE
  ISSUED
  REVOKED
}

/// NONE is the default because most memberships never renew; a renewal is opt-in state.
enum CohortRenewalState {
  NONE
  SCHEDULED
  REMINDED
  RENEWED
  LAPSED
  CANCELLED
}

enum CohortEventKind {
  CREATED
  STATUS
  MEMBERSHIP
  SESSION
  ATTENDANCE
  ASSIGNMENT
  SUBMISSION
  CERTIFICATE
  RENEWAL
  NOTE
}

enum CohortEventActor {
  LEARNER
  STAFF
  SYSTEM
}

model Cohort {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  code  String
  title String

  status   CohortStatus @default(PLANNED)
  timezone String       @default("UTC")
  startsOn DateTime?
  endsOn   DateTime?
  capacity Int?

  /// Certificate policy, stored so eligibility is computed from persisted records
  /// against a configured rule rather than a constant buried in code.
  attendanceThresholdPct Int     @default(0)
  requireAllAssignments  Boolean @default(false)
  requireAllLessons      Boolean @default(false)

  idempotencyKey String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships CohortMembership[]
  sessions    CohortSession[]
  assignments CohortAssignment[]
  events      CohortEvent[]

  @@unique([courseId, code])
  @@unique([profileId, idempotencyKey])
  @@index([profileId, status])
}

model CohortMembership {
  id       String @id @default(cuid())
  cohortId String
  cohort   Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  /// The learner's relation to the PROGRAM already exists as CourseEnrollment. This row
  /// is their relation to one RUN of it, so it points at the enrollment rather than
  /// copying the learner's email, name or payment reference.
  enrollmentId String
  enrollment   CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  status      CohortMembershipStatus @default(INVITED)
  joinedAt    DateTime?
  completedAt DateTime?
  leftAt      DateTime?
  leaveReason String?

  /// Renewal and reminder state lives on the membership because that is what it is
  /// state about. Actual dispatch is a TaskJob, not a second queue.
  renewalState     CohortRenewalState @default(NONE)
  renewalDueAt     DateTime?
  renewalRemindAt  DateTime?
  renewalTaskJobId String?
  renewalTaskJob   TaskJob?           @relation(fields: [renewalTaskJobId], references: [id])

  idempotencyKey String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attendance  CohortAttendance[]
  submissions CohortSubmission[]
  certificate CohortCertificate?

  @@unique([cohortId, enrollmentId])
  @@unique([cohortId, idempotencyKey])
  @@index([cohortId, status])
  @@index([renewalState, renewalRemindAt])
}

model CohortSession {
  id       String @id @default(cuid())
  cohortId String
  cohort   Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  ordinal Int
  title   String

  startsAt DateTime
  endsAt   DateTime

  status CohortSessionStatus @default(SCHEDULED)

  /// Venues reuse the existing Location model instead of a free-text venue column.
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  heldAt       DateTime?
  cancelReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  attendance CohortAttendance[]

  @@unique([cohortId, ordinal])
  @@index([cohortId, startsAt])
}

model CohortAttendance {
  id        String        @id @default(cuid())
  sessionId String
  session   CohortSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  membershipId String
  membership   CohortMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  status     CohortAttendanceStatus
  note       String?
  recordedAt DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@unique([sessionId, membershipId])
  @@index([membershipId, status])
}

model CohortAssignment {
  id       String @id @default(cuid())
  cohortId String
  cohort   Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  ordinal      Int
  title        String
  instructions String?
  dueAt        DateTime?
  maxPoints    Int       @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions CohortSubmission[]

  @@unique([cohortId, ordinal])
}

model CohortSubmission {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   CohortAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  membershipId String
  membership   CohortMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  state CohortSubmissionState @default(DRAFT)

  /// An attached submission is a ProfileDocument, the same upload store the rest of the
  /// platform uses. There is no parallel file table.
  documentId String?
  document   ProfileDocument? @relation(fields: [documentId], references: [id])

  notes       String?
  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewedBy  String?
  points      Int?
  feedback    String?

  idempotencyKey String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([assignmentId, membershipId])
  @@unique([assignmentId, idempotencyKey])
  @@index([membershipId, state])
}

model CohortCertificate {
  id           String           @id @default(cuid())
  membershipId String           @unique
  membership   CohortMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  state CohortCertificateState @default(INELIGIBLE)

  /// Only set once the certificate is actually issued, so an unissued row cannot be
  /// mistaken for a real credential.
  serial    String?   @unique
  issuedAt  DateTime?
  revokedAt DateTime?
  reason    String?

  documentId String?
  document   ProfileDocument? @relation(fields: [documentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
}

/// Append-only cohort timeline, enforced by a trigger rather than by convention.
model CohortEvent {
  id       String @id @default(cuid())
  cohortId String
  cohort   Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  seq      BigInt           @default(autoincrement())
  kind     CohortEventKind
  from     String?
  to       String
  actor    CohortEventActor
  actorId  String?
  metadata Json?
  at       DateTime         @default(now())

  @@index([cohortId, seq])
}

// ---------------------------------------------------------------------------
// Wave F / P2-010: commerce inventory hardening.
//
// WHAT EXISTED: DigitalProduct.stock, one nullable Int. Nothing decremented it,
// nothing reserved against it, there was no location dimension, no movement history
// and no oversell refusal. That column is left EXACTLY as it is here - not renamed,
// not dropped, not migrated - because deciding what its existing values mean is a
// data decision, not a schema one. The new tables are authoritative going forward.
//
// Reuse, not duplication: the product is the pre-existing DigitalProduct, the site is
// the pre-existing Location, and demand is the pre-existing Order and OrderLine. No
// parallel product, order or fulfilment model appears here.
//
// locationId is REQUIRED on purpose. Stock that is not anywhere is not stock, and a
// nullable location would need either a partial unique index or a denormalized
// discriminator column to keep "one record per product per place" enforceable. The
// runtime refuses with a clear message when a workspace has no Location yet.
//
// The oversell guarantee is enforced by CHECK constraints in the migration, not only by
// application code: onHand >= 0, reserved >= 0 and reserved <= onHand. That makes the
// guarantee falsifiable at the storage layer, independent of the engine. Like the four
// append-only triggers and the two exclusion constraints already in this database,
// those constraints live in SQL rather than in this file.
// ---------------------------------------------------------------------------

enum InventoryMovementKind {
  RECEIPT
  ADJUSTMENT
  RESERVE
  RELEASE
  CONSUME
  RETURN
  COUNT
}

enum InventoryMovementActor {
  STAFF
  SYSTEM
  CUSTOMER
}

enum InventoryReservationState {
  HELD
  RELEASED
  CONSUMED
  EXPIRED
}

model InventoryItem {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  productId String
  product   DigitalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  /// Wave G: the sellable unit. Backfilled to each product's deterministic default variant
  /// during the migration, then made NOT NULL, and the unique key moved from
  /// (productId, locationId) to (variantId, locationId). productId is kept as a
  /// denormalized parent and guarded by a composite foreign key so the two cannot disagree.
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// Physical units present. Never negative; enforced by a CHECK constraint.
  onHand Int @default(0)

  /// Units promised to an order line but not yet handed over. Never negative and never
  /// greater than onHand; both enforced by CHECK constraints, so overselling is
  /// impossible at the storage layer and not merely discouraged in code.
  reserved Int @default(0)

  reorderPoint Int?
  safetyStock  Int  @default(0)

  /// A product can opt out of stock control without losing its record, which is what a
  /// made-to-order or digital item needs.
  trackingEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements    InventoryMovement[]
  reservations InventoryReservation[]

  @@unique([variantId, locationId])
  @@index([profileId, locationId])
  @@index([profileId, onHand])
  @@index([productId])
}

/// Append-only movement ledger, enforced by a trigger rather than by convention.
model InventoryMovement {
  id     String        @id @default(cuid())
  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  seq  BigInt                @default(autoincrement())
  kind InventoryMovementKind

  /// Signed effect on onHand and reserved. Storing the deltas AND the resulting
  /// balances makes the ledger self-verifying: replaying the deltas must reproduce the
  /// stored after-values, and the harness checks exactly that.
  qtyDelta      Int
  reservedDelta Int @default(0)
  onHandAfter   Int
  reservedAfter Int

  reason  String?
  actor   InventoryMovementActor @default(STAFF)
  actorId String?

  orderId     String?
  order       Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderLineId String?
  orderLine   OrderLine? @relation(fields: [orderLineId], references: [id], onDelete: SetNull)

  reservationId String?

  idempotencyKey String?
  at             DateTime    @default(now())
  ReturnItem     ReturnItem?

  @@unique([itemId, idempotencyKey])
  @@index([itemId, seq])
  @@index([orderId])
}

/// A hold on stock for one order line. One line, one reservation.
model InventoryReservation {
  id     String        @id @default(cuid())
  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  orderLineId String    @unique
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  qty   Int
  state InventoryReservationState @default(HELD)

  /// A hold that is never confirmed must not strand stock forever. Expiry is recorded
  /// so a sweep can release it; nothing here expires a hold implicitly on read.
  expiresAt  DateTime?
  releasedAt DateTime?
  consumedAt DateTime?

  idempotencyKey String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([itemId, idempotencyKey])
  @@index([itemId, state])
  @@index([state, expiresAt])
}

// ---------------------------------------------------------------------------
// Wave G / P2-011: commerce variants, fulfilment and returns.
//
// WHAT EXISTED: DigitalProduct."variantsJson", a JSON blob of `[{name}]` objects. It
// carried a NAME and nothing else - no SKU, no price, no stock, no identity an order line
// or a stock record could point at. Three UI files parse it back into a newline-joined
// string. That is why commerce:variants was declared `partial` rather than available, and
// it is why this wave adds real variants instead of extending the blob.
//
// The blob is left EXACTLY as it is, like DigitalProduct."stock" before it: still written
// by src/app/actions/products.ts, still read by the product form, the quick-add sheet and
// the public shop page. Reinterpreting its contents is a data decision, not a schema one.
//
// THE SELLABLE UNIT IS NOW ProductVariant. Every existing product receives exactly one
// deterministic default variant in the migration, so nothing that used to be sellable
// stops being sellable, and the reconciliation proof can be exact rather than approximate.
//
// INVENTORY IDENTITY MOVES from (product, location) to (variant, location). That is the
// one non-additive change in this wave and it is enumerated statement by statement in the
// migration. productId stays on InventoryItem as a denormalized parent, guarded by a
// COMPOSITE foreign key (productId, variantId) -> ProductVariant(productId, id) so the
// pair cannot drift apart.
//
// Reuse, not duplication: orders stay Order and OrderLine, money stays Payment, sites stay
// Location, stock stays InventoryItem with its existing CHECK constraints. There is no new
// order, cart, payment or carrier table here. Tracking fields are owner-entered metadata;
// nothing in this wave calls a carrier, a payment processor or a messaging provider.
// ---------------------------------------------------------------------------

enum FulfilmentState {
  DRAFT
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ReturnRequestState {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  CANCELLED
}

/// PENDING is the honest default: a received return has not been restocked until someone
/// decides whether the goods are resellable.
enum ReturnItemRestockState {
  PENDING
  RESTOCKED
  DISCARDED
}

enum CommerceEventKind {
  VARIANT
  FULFILMENT
  RETURN
  RESTOCK
  NOTE
}

enum CommerceEventSubject {
  VARIANT
  FULFILMENT
  RETURN
}

enum CommerceEventActor {
  STAFF
  SYSTEM
  CUSTOMER
}

/// An axis of choice on a product, such as Size or Colour.
model ProductOption {
  id        String         @id @default(cuid())
  productId String
  product   DigitalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  name    String
  ordinal Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values            ProductOptionValue[]
  variantSelections ProductVariantOptionValue[]

  @@unique([productId, name])
  @@index([productId, ordinal])
}

/// One selectable value on an option, such as Medium.
model ProductOptionValue {
  id       String        @id @default(cuid())
  optionId String
  option   ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  value   String
  ordinal Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variantSelections ProductVariantOptionValue[]

  @@unique([optionId, value])
  @@index([optionId, ordinal])
}

/// The sellable unit. Stock, reservations, fulfilment lines and return lines all point here.
model ProductVariant {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  productId String
  product   DigitalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Every product has exactly one default variant, enforced by a partial unique index in
  /// the migration. It is what a non-variant product resolves through, so existing
  /// products keep working without any caller having to know about variants.
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  title   String
  ordinal Int    @default(0)

  /// NULL means "inherit the product price", which is what a default variant does. A
  /// non-null value must be non-negative; enforced by a CHECK constraint.
  priceCents     Int?
  compareAtCents Int?
  weightGrams    Int?

  /// Unique per profile when set. NULLs are distinct in Postgres, so variants without a
  /// SKU coexist freely.
  sku String?

  idempotencyKey String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  optionValues    ProductVariantOptionValue[]
  inventoryItems  InventoryItem[]
  fulfilmentItems FulfilmentItem[]
  returnItems     ReturnItem[]

  /// Target of the composite foreign key from InventoryItem, so a stock record's
  /// productId and variantId cannot disagree.
  @@unique([productId, id])
  @@unique([profileId, sku])
  @@unique([profileId, idempotencyKey])
  @@index([productId, ordinal])
  @@index([profileId, isActive])
}

/// Which option value a variant selects. optionId is denormalized on purpose: it is the
/// only way to say "at most one value per option per variant" as a database constraint.
model ProductVariantOptionValue {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  optionId String
  option   ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  optionValueId String
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([variantId, optionId])
  @@unique([variantId, optionValueId])
  @@index([optionValueId])
}

/// A shipment of part or all of an order. Carrier and tracking are owner-entered strings;
/// nothing here contacts a carrier.
model Fulfilment {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  reference String
  state     FulfilmentState @default(DRAFT)

  /// Owner-entered metadata. There is no carrier integration in this wave, and the UI says
  /// so, so a tracking number here means "the owner typed this", not "we queried anyone".
  carrier        String?
  trackingNumber String?
  trackingUrl    String?

  packedAt     DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  idempotencyKey String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items FulfilmentItem[]

  @@unique([profileId, reference])
  @@unique([profileId, idempotencyKey])
  @@index([orderId, state])
  @@index([profileId, state])
}

/// One order line, partially or wholly, on one shipment.
model FulfilmentItem {
  id           String     @id @default(cuid())
  fulfilmentId String
  fulfilment   Fulfilment @relation(fields: [fulfilmentId], references: [id], onDelete: Cascade)

  orderLineId String
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  /// Positive; enforced by a CHECK constraint. The engine additionally refuses a quantity
  /// that would take the line's cumulative fulfilled total past its ordered quantity.
  qty Int

  createdAt DateTime @default(now())

  @@unique([fulfilmentId, orderLineId])
  @@index([orderLineId])
  @@index([variantId])
}

/// A customer's request to send goods back.
model ReturnRequest {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  reference String
  state     ReturnRequestState @default(REQUESTED)

  reason       String?
  decisionNote String?
  decidedBy    String?

  requestedAt DateTime  @default(now())
  decidedAt   DateTime?
  receivedAt  DateTime?

  /// A pointer to a refund that happened elsewhere. This wave executes no payment; the
  /// field records that a refund exists, and is null until someone links one.
  refundPaymentId String?
  refundPayment   Payment? @relation(fields: [refundPaymentId], references: [id])

  idempotencyKey String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items ReturnItem[]

  @@unique([profileId, reference])
  @@unique([profileId, idempotencyKey])
  @@index([orderId, state])
  @@index([profileId, state])
}

/// One order line on a return, with its own restock decision.
model ReturnItem {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  orderLineId String
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  /// Positive; enforced by a CHECK constraint. The engine refuses more than was fulfilled.
  qty Int

  restockState ReturnItemRestockState @default(PENDING)
  restockedAt  DateTime?

  /// The movement that actually put the units back. Its presence is what makes restocking
  /// idempotent: a second attempt finds this set and refuses to move stock again.
  restockMovementId String?            @unique
  restockMovement   InventoryMovement? @relation(fields: [restockMovementId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([returnRequestId, orderLineId])
  @@index([orderLineId])
  @@index([restockState])
}

/// Append-only commerce timeline for variants, fulfilments and returns, enforced by a
/// trigger. Inventory balance changes keep their own ledger in InventoryMovement; this one
/// records the commerce decisions that drive them.
model CommerceEvent {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  seq         BigInt               @default(autoincrement())
  kind        CommerceEventKind
  subjectType CommerceEventSubject
  subjectId   String

  from    String?
  to      String
  actor   CommerceEventActor @default(STAFF)
  actorId String?

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  metadata Json?
  at       DateTime @default(now())

  @@index([profileId, seq])
  @@index([subjectType, subjectId])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Wave G3 - part one: retainers for cases and projects.
//
// A retainer is an AGREEMENT plus a DRAW-DOWN LEDGER, not a payment. Money movement stays
// where it already lives: CaseInvoice records billing state and Payment records the charge.
// Nothing in this block charges anything, and no row here can cause a charge.
//
// The retainer is workspace-scoped and associated to cases through a link table rather than
// owning a single caseId, because a retainer is an agreement with a client that work from
// several cases draws against. A one-case retainer would make "renewal period" meaningless -
// you would be renewing per case rather than per agreement.
// ---------------------------------------------------------------------------

enum CaseRetainerState {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
}

/// Whether the agreement is denominated in units of work or in money. Exactly one of the two
/// included columns may be set, enforced by a CHECK constraint, because a retainer that is
/// both is a retainer nobody can reconcile.
enum CaseRetainerBasis {
  UNITS
  VALUE
}

enum CaseRetainerPeriodKind {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
  CUSTOM
}

enum CaseRetainerPeriodState {
  OPEN
  CLOSED
  RENEWED
  LAPSED
}

/// A DRAW consumes the allowance, a CREDIT gives some back (a cancelled engagement), and an
/// ADJUSTMENT is a deliberate correction that is recorded rather than hidden by editing a
/// balance. All three are append-only.
enum CaseRetainerDrawKind {
  DRAW
  CREDIT
  ADJUSTMENT
}

model CaseRetainer {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  reference String
  title     String
  state     CaseRetainerState @default(DRAFT)

  basis              CaseRetainerBasis
  includedUnits      Int?
  includedValueCents Int?
  currency           String            @default("USD")

  /// The length of one period. CUSTOM is the only kind that carries periodDays, and it must
  /// carry one - a CHECK constraint enforces both halves of that.
  periodKind CaseRetainerPeriodKind @default(MONTHLY)
  periodDays Int?

  /// Whether an unused allowance survives into the next period. Recorded on the agreement so
  /// that a period can be closed without re-deciding the policy.
  rolloverAllowed Boolean @default(false)

  /// Declares intent only. Nothing in this schema or its runtime renews a retainer on a
  /// timer; renewal is an explicit operation, and a lapsed retainer is left lapsed.
  autoRenew Boolean @default(false)

  activatedAt  DateTime?
  pausedAt     DateTime?
  expiredAt    DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  idempotencyKey String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  periods           CaseRetainerPeriod[]
  caseLinks         CaseRetainerCaseLink[]
  draws             CaseRetainerDraw[]
  CaseRetainerEvent CaseRetainerEvent[]

  @@unique([workspaceId, reference])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, state])
  @@index([contactId])
}

/// Which cases may draw against a retainer. A compound primary key with no surrogate id, the
/// same shape as CaseTaskLink and CaseApprovalLink, because the pair IS the fact.
model CaseRetainerCaseLink {
  retainerId String
  retainer   CaseRetainer @relation(fields: [retainerId], references: [id], onDelete: Cascade)
  caseId     String
  case       CaseProject  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@id([retainerId, caseId])
  @@index([caseId])
}

/// One concrete billing period. The included allowance is SNAPSHOT here rather than read from
/// the agreement, so amending the agreement cannot rewrite what a closed period included.
model CaseRetainerPeriod {
  id         String       @id @default(cuid())
  retainerId String
  retainer   CaseRetainer @relation(fields: [retainerId], references: [id], onDelete: Cascade)

  ordinal  Int
  startsOn DateTime
  endsOn   DateTime

  includedUnits      Int?
  includedValueCents Int?

  /// Maintained by the draw ledger inside the same transaction as the draw. Overage is
  /// allowed - used may exceed included - because refusing a draw once an allowance is spent
  /// would misrepresent work that was actually done. Overage is reported, not prevented.
  usedUnits      Int @default(0)
  usedValueCents Int @default(0)

  state CaseRetainerPeriodState @default(OPEN)

  /// Billing STATE only, mirroring the CaseProject.invoiceState convention. The invoice is a
  /// real CaseInvoice row against one of the retainer's linked cases; this column never moves
  /// money and no payment is executed by anything in this block.
  billingState CaseInvoiceState @default(NONE)
  invoiceId    String?
  invoice      CaseInvoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  closedAt  DateTime?
  renewedAt DateTime?
  lapsedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  draws CaseRetainerDraw[]

  @@unique([retainerId, ordinal])
  @@index([retainerId, state])
  @@index([invoiceId])
}

/// Append-only consumption ledger. Stores the signed delta AND the resulting used balance, so
/// replaying the deltas must reproduce the stored after-values - the same self-verifying shape
/// as InventoryMovement. A row here is never updated or deleted; a trigger enforces that.
model CaseRetainerDraw {
  id         String             @id @default(cuid())
  retainerId String
  retainer   CaseRetainer       @relation(fields: [retainerId], references: [id], onDelete: Cascade)
  periodId   String
  period     CaseRetainerPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  /// Which case the work was done for. Nullable and SetNull on delete, because the ledger has
  /// to survive a case being removed - the allowance really was consumed.
  caseId String?
  case   CaseProject? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  seq  BigInt               @default(autoincrement())
  kind CaseRetainerDrawKind

  unitsDelta          Int?
  valueDeltaCents     Int?
  usedUnitsAfter      Int
  usedValueCentsAfter Int

  note           String?
  idempotencyKey String?
  actor          CaseEventActor
  actorId        String?
  at             DateTime       @default(now())

  @@unique([periodId, idempotencyKey])
  @@index([retainerId, seq])
  @@index([periodId, seq])
  @@index([caseId])
}

// ---------------------------------------------------------------------------
// Wave G3 - part two: access levels for courses and cohorts.
//
// This is the first real content-visibility decision in the repository. Until now any
// ACTIVE or COMPLETED enrolment on a course returned every module and every lesson, and
// CourseLesson.isFree was written by importers but never enforced anywhere.
//
// Tenancy follows the cohort domain exactly: profileId, bridged from Workspace.profileId.
// No Cohort* or Course* table gains a workspaceId.
//
// Nothing here executes a payment. A tier may carry a price so an owner can describe it, and
// an upgrade records that it was requested, decided and applied - but the charge itself stays
// with Payment, referenced by id and never created here.
// ---------------------------------------------------------------------------

enum CourseAccessGrantState {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED
}

/// Where an entitlement came from. PURCHASE means a payment row is referenced, not that this
/// schema charged anybody.
enum CourseAccessGrantSource {
  MANUAL
  PURCHASE
  COHORT
}

enum CourseAccessChangeDirection {
  UPGRADE
  DOWNGRADE
}

enum CourseAccessChangeState {
  REQUESTED
  APPROVED
  REJECTED
  APPLIED
  CANCELLED
}

enum CourseAccessEventKind {
  LEVEL
  VISIBILITY
  GRANT
  CHANGE
  NOTE
}

enum CourseAccessEventActor {
  LEARNER
  STAFF
  SYSTEM
}

/// A tier on a course. rank orders the tiers, so an upgrade is a move to a higher rank and a
/// downgrade a move to a lower one - the direction is derived from data rather than trusted
/// from the caller.
model CourseAccessLevel {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  key         String
  label       String
  rank        Int
  description String?

  /// Describes the tier for an owner. It is not a checkout price and nothing reads it to
  /// charge anybody.
  priceCents Int?
  currency   String  @default("USD")
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessonAccess CourseLessonAccess[]
  grants       CourseAccessGrant[]
  changesFrom  CourseAccessChange[] @relation("CourseAccessChangeFrom")
  changesTo    CourseAccessChange[] @relation("CourseAccessChangeTo")

  @@unique([courseId, key])
  @@unique([courseId, rank])
  @@index([profileId, isActive])
}

/// The minimum tier a lesson requires. A lesson with no row here is visible to every tier,
/// which keeps every existing course behaving exactly as it does today.
model CourseLessonAccess {
  id            String            @id @default(cuid())
  lessonId      String            @unique
  lesson        CourseLesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  accessLevelId String
  accessLevel   CourseAccessLevel @relation(fields: [accessLevelId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([accessLevelId])
}

/// What a learner is entitled to. Keyed on the enrolment, one grant per enrolment, because the
/// enrolment is already the learner-to-course record the content reader resolves. Making the
/// enrolment the identity means the grant needs no idempotency key of its own: asking twice
/// finds the same row.
model CourseAccessGrant {
  id            String            @id @default(cuid())
  enrollmentId  String            @unique
  enrollment    CourseEnrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  accessLevelId String
  accessLevel   CourseAccessLevel @relation(fields: [accessLevelId], references: [id], onDelete: Cascade)

  state  CourseAccessGrantState  @default(PENDING)
  source CourseAccessGrantSource @default(MANUAL)

  grantedAt    DateTime?
  suspendedAt  DateTime?
  expiresAt    DateTime?
  revokedAt    DateTime?
  revokeReason String?

  /// A reference to an existing Payment row when one exists. Deliberately a bare string with
  /// no foreign key, because Payment is profile-scoped while this tree hangs off a course -
  /// the same reason CaseInvoice.paymentId is a bare string.
  paymentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  changes CourseAccessChange[]

  @@index([accessLevelId, state])
  @@index([state, expiresAt])
}

/// One requested move between tiers. This is where "upgrade and downgrade state without real
/// payment execution" actually lives: the change is REQUESTED, then decided, then APPLIED, and
/// applying it rewrites the grant's tier. No money moves at any step.
model CourseAccessChange {
  id      String            @id @default(cuid())
  grantId String
  grant   CourseAccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  fromAccessLevelId String
  fromAccessLevel   CourseAccessLevel @relation("CourseAccessChangeFrom", fields: [fromAccessLevelId], references: [id], onDelete: Cascade)
  toAccessLevelId   String
  toAccessLevel     CourseAccessLevel @relation("CourseAccessChangeTo", fields: [toAccessLevelId], references: [id], onDelete: Cascade)

  direction CourseAccessChangeDirection
  state     CourseAccessChangeState     @default(REQUESTED)

  reason       String?
  decisionNote String?
  decidedBy    String?
  decidedAt    DateTime?
  appliedAt    DateTime?
  cancelledAt  DateTime?

  /// Both are references an owner may record after settling up elsewhere. Nothing here reads
  /// them to decide anything, and nothing here writes a Payment.
  invoiceRef String?
  paymentId  String?

  idempotencyKey String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([grantId, idempotencyKey])
  @@index([grantId, state])
}

/// Append-only history for tiers, visibility rules, entitlements and changes. subjectType and
/// subjectId say what the row is about, so one stream covers all four without a fifth table.
model CourseAccessEvent {
  id          String                 @id @default(cuid())
  courseId    String
  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  seq         BigInt                 @default(autoincrement())
  kind        CourseAccessEventKind
  subjectType String
  subjectId   String
  from        String?
  to          String
  actor       CourseAccessEventActor
  actorId     String?
  metadata    Json?
  at          DateTime               @default(now())

  @@index([courseId, seq])
  @@index([courseId, subjectType, subjectId])
}

/// Append-only history for a retainer AGREEMENT and its periods.
///
/// CaseRetainerDraw already records every movement of the allowance, but it cannot record a
/// state change, and CaseEvent cannot be used either: CaseEvent.caseId is NOT NULL, while a
/// retainer legitimately exists before any case is linked to it. Fanning an agreement event out
/// to every linked case was considered and rejected - a retainer with no links yet would have no
/// history at all, which is precisely the moment an owner most wants one.
///
/// subjectType and subjectId say whether a row is about the agreement, a period, a case link or
/// a draw, so one stream covers all four.
model CaseRetainerEvent {
  id          String         @id @default(cuid())
  retainerId  String
  retainer    CaseRetainer   @relation(fields: [retainerId], references: [id], onDelete: Cascade)
  seq         BigInt         @default(autoincrement())
  kind        CaseEventKind
  subjectType String
  subjectId   String
  from        String?
  to          String
  actor       CaseEventActor
  actorId     String?
  metadata    Json?
  at          DateTime       @default(now())

  @@index([retainerId, seq])
  @@index([retainerId, subjectType, subjectId])
}
