generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique // Map to Clerk User ID
  email     String   @unique
  name      String?
  image     String?
  role      String   @default("CREATOR") // "CREATOR" | "ADMIN"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles Profile[]
}

model Profile {
  id                    String                 @id @default(cuid())
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug                  String                 @unique
  displayName           String
  headline              String?
  bio                   String?
  roleTemplate          String                 @default("CUSTOM") // Enum as String
  primaryGoal           String                 @default("BOOK_CALL") // Enum as String
  language              String                 @default("en")
  timezone              String                 @default("UTC")
  themeColor            String                 @default("#000000")
  animationStyleId      String?
  animationStyle        WelcomeAnimationPreset? @relation(fields: [animationStyleId], references: [id])
  isPublic              Boolean                @default(false)
  showInDirectory       Boolean                @default(false)
  welcomeMessageOverride String?
  contentDisplayMode    String                 @default("POPUP") // "SIDE_PANEL" | "POPUP"
  personalityConfig     String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  documents        ProfileDocument[]
  serviceOfferings ServiceOffering[]
  bookings         Booking[]
  conversations    Conversation[]
  payments         Payment[]
  leads            VisitorLead[]
  availability     AvailabilitySchedule[]
  workExperiences  WorkExperience[]
  projects         Project[]
  digitalProducts  DigitalProduct[]
  courses          Course[]
  events           Event[]
  communities      Community[]
  leadMagnets      LeadMagnet[]
  shortLinks       ShortLink[]
}

model WorkExperience {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company     String
  role        String
  startDate   String   // e.g. "2022" or "Jan 2022"
  endDate     String?  // null = Present
  description String?
  achievements String? // JSON string array
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  description String?
  client      String?
  year        String?
  imageUrl    String?
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WelcomeAnimationPreset {
  id          String   @id @default(cuid())
  name        String
  description String?
  config      String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profiles Profile[]
}

model ProfileDocument {
  id                String              @id @default(cuid())
  profileId         String
  profile           Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type              String              // Enum
  title             String
  sourceType        String              // Enum
  url               String?
  filePath          String?
  rawText           String?
  embeddingMetadata String?             // Json
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model ServiceOffering {
  id                String   @id @default(cuid())
  profileId         String
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  priceCents        Int      @default(0)
  currency          String   @default("USD")
  isFree            Boolean  @default(false)
  durationMinutes   Int      @default(30)
  isActive          Boolean  @default(true)
  isRecurring       Boolean  @default(false)
  maxBookingsPerDay Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  bookings Booking[]
}

model Booking {
  id                String        @id @default(cuid())
  profileId         String
  profile           Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  visitorId         String?       
  visitorName       String
  visitorEmail      String
  serviceOfferingId String
  serviceOffering   ServiceOffering @relation(fields: [serviceOfferingId], references: [id])
  startTime         DateTime
  endTime           DateTime
  status            String          @default("PENDING_PAYMENT") // Enum
  paymentId         String?         @unique
  payment           Payment?        @relation(fields: [paymentId], references: [id])
  metadata          String?         // Json
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Payment {
  id                String          @id @default(cuid())
  profileId         String
  profile           Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  bookingId         String?         @unique 
  booking           Booking?
  amountCents       Int
  currency          String
  status            String          @default("PENDING") // Enum
  provider          String          @default("STRIPE") // Enum
  providerPaymentId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Conversation {
  id             String             @id @default(cuid())
  profileId      String
  profile        Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  visitorId      String?
  visitorName    String?
  visitorEmail   String?
  source         String             @default("PROFILE_PAGE") // Enum
  leadStatus     String             @default("NEW") // Enum
  notes          String?            
  startedAt      DateTime           @default(now())
  endedAt        DateTime?
  lastMessageAt  DateTime           @default(now())

  messages     Message[]
  visitorLeads VisitorLead[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     String       // Enum
  text           String       
  role           String       
  createdAt      DateTime     @default(now())
}

model VisitorLead {
  id             String            @id @default(cuid())
  profileId      String
  profile        Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation?     @relation(fields: [conversationId], references: [id])
  name           String
  email          String
  company        String?
  budgetRange    String?
  status         String            @default("NEW") // Enum
  tags           String?           // Json
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model AdminSettings {
  id    String @id @default(cuid())
  key   String @unique
  value String // Json
}

model AvailabilitySchedule {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 0-6 (Sun-Sat)
  startTime String   // "09:00"
  endTime   String   // "17:00"
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== SuperProfile-like Features ====================

model DigitalProduct {
  id            String   @id @default(cuid())
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  type          String   @default("OTHER") // "PDF" | "VIDEO" | "AUDIO" | "OTHER"
  fileUrl       String?
  thumbnailUrl  String?
  priceCents    Int      @default(0)
  currency      String   @default("USD")
  isActive      Boolean  @default(true)
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchases ProductPurchase[]
}

model Course {
  id            String   @id @default(cuid())
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  thumbnailUrl  String?
  priceCents    Int      @default(0)
  currency      String   @default("USD")
  isActive      Boolean  @default(true)
  isPublished   Boolean  @default(false)
  totalModules  Int      @default(0)
  totalLessons  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  modules     CourseModule[]
  enrollments CourseEnrollment[]
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons CourseLesson[]
}

model CourseLesson {
  id              String   @id @default(cuid())
  moduleId        String
  module          CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  contentType     String   @default("VIDEO") // "VIDEO" | "TEXT" | "PDF"
  contentUrl      String?
  durationMinutes Int      @default(0)
  orderIndex      Int      @default(0)
  isFree          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Event {
  id            String    @id @default(cuid())
  profileId     String
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  eventType     String    @default("WEBINAR") // "WEBINAR" | "WORKSHOP" | "MEETUP"
  thumbnailUrl  String?
  startTime     DateTime
  endTime       DateTime
  timezone      String    @default("UTC")
  location      String?   // For offline events
  meetingUrl    String?   // For online events
  priceCents    Int       @default(0)
  currency      String    @default("USD")
  isFree        Boolean   @default(false)
  maxAttendees  Int?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  registrations EventRegistration[]
}

model Community {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  platform     String   @default("TELEGRAM") // "TELEGRAM" | "DISCORD"
  inviteLink   String?
  priceCents   Int      @default(0)
  currency     String   @default("USD")
  billingCycle String   @default("MONTHLY") // "MONTHLY" | "YEARLY" | "ONE_TIME"
  isActive     Boolean  @default(true)
  memberCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members CommunityMember[]
}

model LeadMagnet {
  id            String   @id @default(cuid())
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  type          String   @default("DOWNLOAD") // "FORM" | "GIVEAWAY" | "DOWNLOAD"
  fileUrl       String?
  formFields    String?  // JSON array of form field definitions
  isActive      Boolean  @default(true)
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  submissions LeadMagnetSubmission[]
}

model ShortLink {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  code      String   @unique // Unique short code for the link
  targetUrl String
  title     String?
  clicks    Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductPurchase {
  id           String    @id @default(cuid())
  productId    String
  product      DigitalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  visitorEmail String
  visitorName  String?
  paymentId    String?
  status       String    @default("PENDING") // "PENDING" | "COMPLETED" | "REFUNDED"
  downloadedAt DateTime?
  createdAt    DateTime  @default(now())
}

model CourseEnrollment {
  id           String    @id @default(cuid())
  courseId     String
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  visitorEmail String
  visitorName  String?
  paymentId    String?
  status       String    @default("PENDING") // "PENDING" | "ACTIVE" | "COMPLETED" | "CANCELLED"
  progress     String?   // JSON object tracking lesson completion
  enrolledAt   DateTime  @default(now())
  completedAt  DateTime?
}

model EventRegistration {
  id           String    @id @default(cuid())
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  visitorEmail String
  visitorName  String?
  paymentId    String?
  status       String    @default("REGISTERED") // "REGISTERED" | "ATTENDED" | "CANCELLED"
  attendedAt   DateTime?
  createdAt    DateTime  @default(now())
}

model CommunityMember {
  id                 String    @id @default(cuid())
  communityId        String
  community          Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  visitorEmail       String
  visitorName        String?
  paymentId          String?
  status             String    @default("ACTIVE") // "ACTIVE" | "EXPIRED" | "CANCELLED"
  subscriptionEndsAt DateTime?
  createdAt          DateTime  @default(now())
}

model LeadMagnetSubmission {
  id           String     @id @default(cuid())
  leadMagnetId String
  leadMagnet   LeadMagnet @relation(fields: [leadMagnetId], references: [id], onDelete: Cascade)
  visitorEmail String
  visitorName  String?
  formData     String?    // JSON object with form field values
  createdAt    DateTime   @default(now())
}
