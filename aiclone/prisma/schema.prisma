generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderChannel {
  DINE_IN
  TAKEAWAY
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  SERVED
  PAID
  CANCELLED
}

enum OrderLineStatus {
  QUEUED
  PREPARING
  READY
  SERVED
}

enum OrderPayMethod {
  UPI
  COD
  WHATSAPP
  STRIPE
}

enum OrderPayStatus {
  UNPAID
  PAID
  REFUNDED
}

enum OrderEventActor {
  GUEST
  STAFF
  SYSTEM
}

enum OrderEventKind {
  CREATED
  ORDER_STATUS
  LINE_STATUS
  PAYMENT_STATUS
  BACKFILL
}

enum OfferReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum ProfileImageCategory {
  AMBIENCE
  INTERIOR
  FOOD
  TEAM
  EVENT
}

/// Reservation lifecycle. Terminal states are COMPLETED, CANCELLED and NO_SHOW.
/// Transitions are enforced in src/lib/reservations, not by the database alone.
enum ReservationStatus {
  REQUESTED
  HELD
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReservationEventKind {
  CREATED
  STATUS
  HOLD_EXPIRED
}

/// Deliberately separate from OrderEventActor so the existing order enum is not
/// widened or otherwise modified.
enum ReservationEventActor {
  GUEST
  STAFF
  SYSTEM
}

/// Assignable appointment capacity: a person, a room, or a piece of equipment.
/// One vocabulary for coaching, consulting, CA practice, salon, events, real estate
/// and pet care, so no industry gets a forked booking system.
enum AppointmentResourceKind {
  STAFF
  ROOM
  EQUIPMENT
}

enum AppointmentWaitlistStatus {
  WAITING
  OFFERED
  CONVERTED
  EXPIRED
  CANCELLED
}

/// Deposit intent state. NONE means the service does not take a deposit; it is
/// modelled explicitly rather than by a null row so the absence is deliberate.
enum AppointmentDepositState {
  NONE
  REQUIRED
  AUTHORIZED
  CAPTURED
  REFUNDED
  FORFEITED
  FAILED
}

enum AppointmentReminderChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum AppointmentReminderState {
  SCHEDULED
  SENT
  FAILED
  CANCELLED
  SUPPRESSED
}

enum AppointmentEventKind {
  CREATED
  STATUS
  DEPOSIT
  REMINDER
  WAITLIST
}

enum AppointmentEventActor {
  GUEST
  STAFF
  SYSTEM
}

model User {
  id                     String   @id @default(cuid())
  clerkId                String   @unique // Map to Clerk User ID
  email                  String   @unique
  name                   String?
  image                  String?
  role                   String   @default("CREATOR") // "CREATOR" | "ADMIN"
  stripeConnectAccountId String? // Stripe Connect account for payouts
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  profiles      Profile[]
  notifications Notification[]
}

model Profile {
  id                     String                  @id @default(cuid())
  userId                 String
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug                   String                  @unique
  displayName            String
  headline               String?
  bio                    String?
  roleTemplate           String                  @default("CUSTOM") // Enum as String
  primaryGoal            String                  @default("BOOK_CALL") // Enum as String
  language               String                  @default("en")
  timezone               String                  @default("UTC")
  themeColor             String                  @default("#000000")
  imageUrl               String?
  shopLogoUrl            String?
  whatsapp               String?
  upiId                  String?
  gstin                  String?
  deliveryNote           String?
  chatAvatarMode         String                  @default("ORB") // "ORB" | "IMAGE"
  animationStyleId       String?
  animationStyle         WelcomeAnimationPreset? @relation(fields: [animationStyleId], references: [id])
  isPublic               Boolean                 @default(false)
  showInDirectory        Boolean                 @default(false)
  welcomeMessageOverride String?
  contentDisplayMode     String                  @default("POPUP") // "SIDE_PANEL" | "POPUP"
  personalityConfig      String? // JSON: {tone, customInstructions, responseLength, language}
  aiModel                String                  @default("gpt-4o-mini") // "gpt-4o-mini" | "gpt-4o"
  autoMemoryEnabled      Boolean                 @default(false)
  liveChatEnabled        Boolean                 @default(false)
  liveChatSlaMinutes     Int                     @default(10)
  bufferMinutes          Int                     @default(0)
  calendarToken          String?                 @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  documents         ProfileDocument[]
  serviceOfferings  ServiceOffering[]
  bookings          Booking[]
  conversations     Conversation[]
  payments          Payment[]
  leads             VisitorLead[]
  availability      AvailabilitySchedule[]
  calendarOverrides CalendarOverride[]
  workExperiences   WorkExperience[]
  projects          Project[]
  digitalProducts   DigitalProduct[]
  courses           Course[]
  events            Event[]
  communities       Community[]
  leadMagnets       LeadMagnet[]
  shortLinks        ShortLink[]
  analyticsEvents   ProfileEvent[]
  restaurantOrders  Order[]
  restaurantTables  RestaurantTable[]
  orderCounters     OrderCounter[]
  profileImages     ProfileImage[]
  restaurantReviews OfferReview[]
  reservations      Reservation[]

  appointmentResources AppointmentResource[]
  appointmentWaitlist  AppointmentWaitlistEntry[]
  appointmentDeposits  AppointmentDeposit[]
  appointmentReminders AppointmentReminder[]
}

model ProfileEvent {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  path      String?
  ref       String?
  visitor   String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
  @@index([profileId, name, createdAt])
}

model WorkExperience {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company      String
  role         String
  startDate    String // e.g. "2022" or "Jan 2022"
  endDate      String? // null = Present
  description  String?
  achievements String? // JSON string array
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  description String?
  client      String?
  year        String?
  imageUrl    String?
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WelcomeAnimationPreset {
  id          String   @id @default(cuid())
  name        String
  description String?
  config      String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profiles Profile[]
}

model ProfileDocument {
  id                  String                @id @default(cuid())
  profileId           String
  profile             Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type                String // Enum
  title               String
  sourceType          String // Enum
  url                 String?
  filePath            String?
  rawText             String?
  embedding           Float[] // OpenAI embedding vector
  embeddingMetadata   String? // Json
  visitorKey          String?
  memberId            String?
  conversationId      String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  CaseDeliverable     CaseDeliverable[]
  CaseDocumentRequest CaseDocumentRequest[]

  @@index([profileId, visitorKey])
}

model ServiceOffering {
  id                String   @id @default(cuid())
  profileId         String
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  priceCents        Int      @default(0)
  currency          String   @default("USD")
  isFree            Boolean  @default(false)
  durationMinutes   Int      @default(30)
  isActive          Boolean  @default(true)
  isRecurring       Boolean  @default(false)
  packageSessions   Int      @default(1)
  maxBookingsPerDay Int?
  kind              String   @default("SESSION") // "SESSION" | "TABLE"
  covers            Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  bookings          Booking[]
  eligibleResources ServiceResource[]
  waitlistEntries   AppointmentWaitlistEntry[]
}

/// Appointment booking.
///
/// EVOLVED, NOT REPLACED. Every column added by Wave B is nullable or defaulted, so
/// the pre-existing rows and the pre-existing booking flow stay valid.
///
/// `status` is deliberately left as `String`. It is `text NOT NULL` in the live
/// schema with real data in it, so converting it to a Prisma enum would be a
/// breaking change rather than an additive one. The canonical vocabulary and the
/// legal transitions live in src/lib/appointments/lifecycle.ts, which validates on
/// the way in. A future migration may tighten the column once legacy values are
/// audited; until then TypeScript is the single source of truth and the exclusion
/// constraint below references the same literals.
model Booking {
  id                String          @id @default(cuid())
  profileId         String
  profile           Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  visitorId         String?
  visitorName       String
  visitorEmail      String
  memberId          String?
  member            Member?         @relation(fields: [memberId], references: [id])
  serviceOfferingId String
  serviceOffering   ServiceOffering @relation(fields: [serviceOfferingId], references: [id])
  startTime         DateTime
  endTime           DateTime
  status            String          @default("PENDING_PAYMENT") // vocabulary owned by src/lib/appointments/lifecycle.ts
  paymentId         String?         @unique
  payment           Payment?        @relation(fields: [paymentId], references: [id])
  metadata          String? // Json
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // ---- Wave B additive appointment fields ----
  resourceId     String?
  resource       AppointmentResource? @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  locationId     String?
  location       Location?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  idempotencyKey String?
  partySize      Int                  @default(1)
  holdExpiresAt  DateTime?
  confirmedAt    DateTime?
  checkedInAt    DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  noShowAt       DateTime?
  cancelReason   String?

  deposit           AppointmentDeposit?
  reminders         AppointmentReminder[]
  appointmentEvents AppointmentEvent[]
  waitlistOffers    AppointmentWaitlistEntry[]

  @@unique([profileId, idempotencyKey])
  @@index([profileId, startTime])
  @@index([profileId, status])
  @@index([resourceId, startTime])
}

/// A person, room, or piece of equipment that an appointment can consume.
model AppointmentResource {
  id         String                  @id @default(cuid())
  profileId  String
  profile    Profile                 @relation(fields: [profileId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location?               @relation(fields: [locationId], references: [id], onDelete: SetNull)
  name       String
  kind       AppointmentResourceKind @default(STAFF)
  /// Simultaneous appointments this resource can hold. NULL means unknown, which the
  /// engine treats as fail-closed rather than unlimited.
  capacity   Int?
  isActive   Boolean                 @default(true)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  bookings        Booking[]
  services        ServiceResource[]
  waitlistEntries AppointmentWaitlistEntry[]

  @@unique([profileId, name])
  @@index([profileId, isActive])
}

/// Which resources are eligible to deliver which service.
model ServiceResource {
  serviceOfferingId String
  serviceOffering   ServiceOffering     @relation(fields: [serviceOfferingId], references: [id], onDelete: Cascade)
  resourceId        String
  resource          AppointmentResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([serviceOfferingId, resourceId])
  @@index([resourceId])
}

model AppointmentWaitlistEntry {
  id                String                    @id @default(cuid())
  profileId         String
  profile           Profile                   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  serviceOfferingId String
  serviceOffering   ServiceOffering           @relation(fields: [serviceOfferingId], references: [id], onDelete: Cascade)
  resourceId        String?
  resource          AppointmentResource?      @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  requestedStart    DateTime
  requestedEnd      DateTime
  partySize         Int                       @default(1)
  guestName         String
  guestEmail        String?
  guestPhone        String?
  status            AppointmentWaitlistStatus @default(WAITING)
  offeredBookingId  String?
  offeredBooking    Booking?                  @relation(fields: [offeredBookingId], references: [id], onDelete: SetNull)
  offerExpiresAt    DateTime?
  idempotencyKey    String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([profileId, idempotencyKey])
  @@index([profileId, status, requestedStart])
  @@index([serviceOfferingId, status])
}

model AppointmentDeposit {
  id             String                  @id @default(cuid())
  bookingId      String                  @unique
  booking        Booking                 @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  profileId      String
  profile        Profile                 @relation(fields: [profileId], references: [id], onDelete: Cascade)
  amountCents    Int
  currency       String                  @default("USD")
  state          AppointmentDepositState @default(REQUIRED)
  /// Opaque reference from the payment provider. No provider is called by this wave.
  providerRef    String?
  idempotencyKey String?
  failureCode    String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([profileId, idempotencyKey])
  @@index([profileId, state])
}

model AppointmentReminder {
  id           String                     @id @default(cuid())
  bookingId    String
  booking      Booking                    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  profileId    String
  profile      Profile                    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  channel      AppointmentReminderChannel
  sendAt       DateTime
  state        AppointmentReminderState   @default(SCHEDULED)
  attempts     Int                        @default(0)
  lastError    String?
  dispatchedAt DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  /// One reminder per booking, channel and moment. This is what makes reminder
  /// scheduling idempotent under replay.
  @@unique([bookingId, channel, sendAt])
  @@index([state, sendAt])
  @@index([profileId, state])
}

/// Append-only appointment ledger. UPDATE and DELETE are refused by trigger, reusing
/// reject_append_only_mutation() from 20260827140000_phase0_foundations.
model AppointmentEvent {
  id        String                @id @default(cuid())
  bookingId String
  booking   Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seq       BigInt                @default(autoincrement())
  kind      AppointmentEventKind
  from      String?
  to        String
  actor     AppointmentEventActor
  actorId   String?
  metadata  Json?
  at        DateTime              @default(now())

  @@index([bookingId, seq])
}

model Payment {
  id                String   @id @default(cuid())
  profileId         String
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  bookingId         String?  @unique
  booking           Booking?
  amountCents       Int
  currency          String
  status            String   @default("PENDING") // Enum
  provider          String   @default("STRIPE") // Enum
  providerPaymentId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Conversation {
  id                  String    @id @default(cuid())
  profileId           String
  profile             Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  visitorId           String?
  visitorName         String?
  visitorEmail        String?
  memberId            String?
  member              Member?   @relation(fields: [memberId], references: [id])
  source              String    @default("PROFILE_PAGE") // Enum
  leadStatus          String    @default("NEW") // Enum
  notes               String?
  mode                String    @default("AI") // "AI" | "LIVE_REQUESTED" | "LIVE"
  liveRequestedAt     DateTime?
  liveRespondedAt     DateTime?
  lastSummarizedMsgId String?
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  lastMessageAt       DateTime  @default(now())

  messages     Message[]
  visitorLeads VisitorLead[]

  @@index([profileId, visitorId])
  @@index([profileId, mode])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     String // Enum
  text           String
  role           String
  createdAt      DateTime     @default(now())
}

model VisitorLead {
  id             String        @id @default(cuid())
  profileId      String
  profile        Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  name           String
  email          String
  company        String?
  budgetRange    String?
  status         String        @default("NEW") // Enum
  tags           String? // Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model AdminSettings {
  id    String @id @default(cuid())
  key   String @unique
  value String // Json
}

model AvailabilitySchedule {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0-6 (Sun-Sat)
  startTime String // "09:00"
  endTime   String // "17:00"
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CalendarOverride {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date      DateTime
  isBlocked Boolean  @default(true)
  startTime String?
  endTime   String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId, date])
}

// ==================== SuperProfile-like Features ====================

model DigitalProduct {
  id             String   @id @default(cuid())
  profileId      String
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  type           String   @default("OTHER") // "PDF" | "VIDEO" | "AUDIO" | "OTHER" | "PHYSICAL"
  fileUrl        String?
  thumbnailUrl   String?
  subtitle       String?
  body           String?
  compareAtCents Int?
  highlights     String?
  galleryUrls    String?
  fulfillment    String   @default("DIGITAL") // "DIGITAL" | "PHYSICAL" | "BOTH"
  stock          Int?
  sku            String?
  weightGrams    Int?
  allowCod       Boolean  @default(false)
  category       String?
  diet           String?
  spiceLevel     Int?
  serveWindow    String?
  arModelUrl     String?
  arUsdzUrl      String?
  variantsJson   String?
  shipMode       String   @default("NONE") // "NONE" | "PICKUP" | "DELIVER" | "BOTH"
  shipFeeCents   Int      @default(0)
  priceCents     Int      @default(0)
  currency       String   @default("USD")
  isActive       Boolean  @default(true)
  downloadCount  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchases  ProductPurchase[]
  reviews    OfferReview[]
  orderLines OrderLine[]
}

model Course {
  id             String   @id @default(cuid())
  profileId      String
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  thumbnailUrl   String?
  subtitle       String?
  body           String?
  outcomes       String?
  level          String   @default("ALL")
  compareAtCents Int?
  priceCents     Int      @default(0)
  currency       String   @default("USD")
  isActive       Boolean  @default(true)
  isPublished    Boolean  @default(false)
  totalModules   Int      @default(0)
  totalLessons   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  modules     CourseModule[]
  enrollments CourseEnrollment[]
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons CourseLesson[]
}

model CourseLesson {
  id              String       @id @default(cuid())
  moduleId        String
  module          CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  contentType     String       @default("VIDEO") // "VIDEO" | "TEXT" | "PDF"
  contentUrl      String?
  videoUrl        String?
  body            String?
  fileUrl         String?
  durationMinutes Int          @default(0)
  orderIndex      Int          @default(0)
  isFree          Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Event {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  eventType    String   @default("WEBINAR") // "WEBINAR" | "WORKSHOP" | "MEETUP"
  thumbnailUrl String?
  startTime    DateTime
  endTime      DateTime
  timezone     String   @default("UTC")
  location     String? // For offline events
  meetingUrl   String? // For online events
  priceCents   Int      @default(0)
  currency     String   @default("USD")
  isFree       Boolean  @default(false)
  maxAttendees Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  registrations EventRegistration[]
}

model Community {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  platform     String   @default("TELEGRAM") // "TELEGRAM" | "DISCORD"
  inviteLink   String?
  priceCents   Int      @default(0)
  currency     String   @default("USD")
  billingCycle String   @default("MONTHLY") // "MONTHLY" | "YEARLY" | "ONE_TIME"
  isActive     Boolean  @default(true)
  memberCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members CommunityMember[]
}

model LeadMagnet {
  id            String   @id @default(cuid())
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  type          String   @default("DOWNLOAD") // "FORM" | "GIVEAWAY" | "DOWNLOAD"
  fileUrl       String?
  formFields    String? // JSON array of form field definitions
  isActive      Boolean  @default(true)
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  submissions LeadMagnetSubmission[]
}

model ShortLink {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  code      String   @unique // Unique short code for the link
  targetUrl String
  title     String?
  clicks    Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Member {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String?
  imageUrl   String?
  clerkId    String?  @unique
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sessions      MemberSession[]
  libraryLinks  LibraryLink[]
  purchases     ProductPurchase[]
  enrollments   CourseEnrollment[]
  events        EventRegistration[]
  communities   CommunityMember[]
  bookings      Booking[]
  conversations Conversation[]
}

model MemberSession {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model LibraryLink {
  id        String    @id @default(cuid())
  memberId  String
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ProductPurchase {
  id             String         @id @default(cuid())
  productId      String
  product        DigitalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  memberId       String?
  member         Member?        @relation(fields: [memberId], references: [id])
  visitorEmail   String
  visitorName    String?
  paymentId      String?
